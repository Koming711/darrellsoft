// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grup {
  id        String     @id @default(cuid())
  nama      String
  createdAt DateTime   @default(now())
  pengguna  Pengguna[]
}

model Pengguna {
  id           String         @id @default(cuid())
  namaLengkap  String
  nomorHP      String
  email        String
  username     String         @unique
  password     String
  role         String         @default("user")
  grupId       String?
  grup         Grup?          @relation(fields: [grupId], references: [id])
  createdAt    DateTime       @default(now())
  validUntil   DateTime?
  calonPembeli CalonPembeli[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  code        String?
  name        String
  companyName String?
  address     String?
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barangRegs BarangCustomer[]
}

model Barang {
  id         String   @id @default(cuid())
  kode       String
  nama       String
  satuan     String   @default("pcs")
  qty        Float    @default(0)
  modal      Float    @default(0)
  jual       Float    @default(0)
  keterangan String   @default("")
  photoUrl   String?
  isActive   Boolean  @default(true)
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  registrations BarangCustomer[]

  @@unique([userId, kode])
  @@index([userId])
}

model BarangCustomer {
  id         String   @id @default(cuid())
  barangId   String
  customerId String
  price      Float
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barang   Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([barangId, customerId])
  @@index([userId])
}

model Paper {
  id          String    @id @default(cuid())
  name        String
  grammage    Int
  width       Float
  height      Float
  pricePerRim Float
  kategoriId  String?
  kategori    Kategori? @relation(fields: [kategoriId], references: [id], onDelete: SetNull)
  suplier     String?
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Daftar Kategori bahan kertas — dipakai di dropdown Kategori pada Master Harga Kertas.
// TIDAK terdaftar di matriks Hak Akses (tampil untuk semua user login), pola produksi v123.
model Kategori {
  id        String   @id @default(cuid())
  nama      String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers Paper[]
}

model PrintingCost {
  id                        String   @id @default(cuid())
  machineName               String
  grammage                  Int
  printAreaWidth            Float
  printAreaHeight           Float
  pricePerColor             Float
  specialColorPrice         Float
  minimumPrintQuantity      Int
  priceAboveMinimumPerSheet Float
  platePricePerSheet        Float
  userId                    String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Finishing {
  id              String   @id @default(cuid())
  name            String
  minimumSheets   Int
  minimumPrice    Float
  additionalPrice Float
  pricePerCm      Float
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CalonPembeli {
  id          String    @id @default(cuid())
  nama        String
  nomorHP     String
  email       String
  alamat      String
  catatan     String
  status      String    @default("baru")
  role        String    @default("demo")
  expiredDate DateTime?
  username    String?
  password    String?
  userId      String?
  pengguna    Pengguna? @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Pembeli {
  id          String    @id @default(cuid())
  nama        String
  nomorHP     String
  email       String
  alamat      String
  catatan     String
  role        String    @default("demo")
  expiredDate DateTime?
  userId      String?
  penggunaId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// OTP verification codes sent via WhatsApp (Fonnte) for self-registration
model RegisterOtp {
  id        String   @id @default(cuid())
  nomorHP   String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nomorHP])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-user settings for multi-tenant isolation.
// System/global defaults live in `Setting` (key @unique, no user).
// User-specific overrides live here. Reads merge: UserSetting > Setting (fallback).
// System keys (role_permissions, custom_roles, session_*, demo_*, single_device*,
// auto_logout_min, logout_warning_sec, auto_backup_days, master_cleared_*,
// last_auto_backup_*, branding_default_v3) stay GLOBAL in `Setting`.
model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model RiwayatCetakan {
  id                 String   @id @default(cuid())
  nomorUrut          String   @unique @default("")
  type               String   @default("hitung_cetakan")
  printName          String
  customerName       String   @default("")
  paperName          String
  paperGrammage      String
  paperLength        String
  paperWidth         String
  cutWidth           String
  cutHeight          String
  quantity           String
  jumlahPesanan      String   @default("")
  berapaMata         String   @default("")
  namaSuplier        String   @default("") // suplier harga bahan (Master Toko Pemasok)
  setelanKertas      String   @default("")
  warna              String
  warnaKhusus        String
  machineName        String
  hargaPlat          Float
  ongkosCetak        Float
  ongkosCetakDetail  String
  machineName2       String   @default("")
  warna2             String   @default("")
  warnaKhusus2       String   @default("")
  hargaPlat2         Float    @default(0)
  ongkosCetak2       Float    @default(0)
  ongkosCetak2Detail String   @default("")
  totalPaperPrice    Float
  pricePerSheet      Float    @default(0)
  finishingNames     String
  finishingBreakdown String
  finishingCost      Float
  packingCost        Float
  shippingCost       Float
  otherCost          Float    @default(0)
  otherCost2         Float    @default(0)
  otherCostLabel     String   @default("")
  otherCostLabel2    String   @default("")
  glueLengthCm       String   @default("")
  glueCostPerCm      String   @default("")
  glueCost           Float    @default(0)
  glueBorongan       Float    @default(0)
  subTotal           Float
  profitPercent      Float
  profitAmount       Float
  grandTotal         Float
  simulasiCepat      String   @default("")
  pkRiwayatId        String? // id RiwayatPotongKertas sumber — hubungan deterministik Potong Kertas ↔ Hitung Cetakan
  photoUrl           String?
  userId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RiwayatFinishing {
  id             String   @id @default(cuid())
  namaCustomer   String   @default("")
  namaCetakan    String
  jumlahLembar   String
  lebarCm        String
  tinggiCm       String
  finishingNames String
  finishingIds   String
  totalCost      Float
  hargaPerLembar Float    @default(0)
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RiwayatOngkosCetak {
  id                String   @id @default(cuid())
  namaCustomer      String   @default("")
  namaCetakan       String
  machineName       String
  machineId         String   @default("")
  jumlahWarna       String
  warnaKhusus       String   @default("0")
  hargaPlat         String   @default("0")
  jumlahLembar      String
  totalOngkosCetak  Float
  hargaPerLembar    Float    @default(0)
  machineId2        String   @default("")
  machineName2      String   @default("")
  jumlahWarna2      String   @default("0")
  warnaKhusus2      String   @default("0")
  hargaPlat2        String   @default("0")
  totalOngkosCetak2 Float    @default(0)
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RiwayatHargaKertas {
  id           String   @id @default(cuid())
  namaCustomer String   @default("")
  namaCetakan  String
  paperName    String
  paperId      String   @default("")
  namaSuplier  String   @default("") // suplier harga bahan (Master Toko Pemasok)
  grammage     String   @default("0")
  paperWidth   String   @default("0")
  paperHeight  String   @default("0")
  pricePerRim  String   @default("0")
  quantity     String   @default("0")
  lebarPotong  String   @default("0")
  tinggiPotong String   @default("0")
  totalPrice   Float
  costPerPiece Float    @default(0)
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RiwayatPotongKertas {
  id            String   @id @default(cuid())
  nomorUrut     String   @unique @default("")
  namaCustomer  String   @default("")
  namaCetakan   String
  paperName     String
  paperId       String   @default("")
  grammage      String   @default("0")
  paperWidth    String   @default("0")
  paperHeight   String   @default("0")
  cutWidth      String   @default("0")
  cutHeight     String   @default("0")
  quantity      String   @default("0")
  setelanKertas String   @default("0")
  sheetsNeeded  String   @default("0")
  totalPrice    Float    @default(0)
  pricePerSheet Float    @default(0)
  efficiency    Float    @default(0)
  strategy      String   @default("")
  jumlahPesanan String   @default("")
  berapaMata    String   @default("")
  namaSuplier   String   @default("") // suplier harga bahan (Master Toko Pemasok)
  resultData    String   @default("")
  photoUrl      String?
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id               String   @id @default(cuid())
  invoiceNumber    String   @unique
  customerName     String
  customerAddress  String   @default("")
  customerPhone    String   @default("")
  customerEmail    String   @default("")
  invoiceDate      String
  dueDate          String   @default("")
  items            String
  subTotal         Float    @default(0)
  discount         Float    @default(0)
  tax              Float    @default(0)
  grandTotal       Float    @default(0)
  notes            String   @default("")
  status           String   @default("draft")
  riwayatCetakanId String?
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  packageName       String
  packageType       String
  grossAmount       Float
  customerName      String    @default("")
  customerEmail     String    @default("")
  customerPhone     String    @default("")
  paymentType       String?
  transactionId     String?
  transactionTime   DateTime?
  transactionStatus String    @default("pending")
  fraudStatus       String?
  userId            String?
  metadata          String    @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SuratJalan {
  id               String   @id @default(cuid())
  suratJalanNumber String   @unique
  customerName     String
  customerAddress  String   @default("")
  customerPhone    String   @default("")
  driverName       String   @default("")
  vehicleNumber    String   @default("")
  deliveryDate     String
  items            String
  notes            String   @default("")
  status           String   @default("draft")
  invoiceId        String?
  riwayatCetakanId String?
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique
  supplierName    String
  supplierAddress String   @default("")
  supplierPhone   String   @default("")
  orderDate       String
  deliveryDate    String   @default("")
  items           String
  subtotal        Float    @default(0)
  tax             Float    @default(0)
  total           Float    @default(0)
  notes           String   @default("")
  status          String   @default("draft")
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TokoPemasok {
  id          String   @id @default(cuid())
  namaToko    String
  jenisBarang String   @default("")
  kontak      String   @default("")
  alamat      String   @default("")
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentHistory {
  id         String    @id @default(cuid())
  docType    String
  nomor      String
  tanggal    String    @default("")
  pihakKedua String    @default("")
  total      String    @default("")
  dataJson   String
  userId     String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // Soft delete — non-null = masuk Sampah (bisa dipulihkan)
}

/// Persistent sequence counter — ensures document numbers NEVER decrease
/// or get reused, even when documents are deleted. Each (prefix, period, user)
/// combination has its own monotonically-increasing counter.
model DocumentCounter {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "documentHistory|INV|2607|userId"
  lastNum   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  userType  String   @default("pengguna") // "pengguna" or "calon_pembeli"
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Biaya {
  id               String   @id @default(cuid())
  tanggal          String // ISO date string (YYYY-MM-DD) for portability across SQLite/Postgres
  kategori         String // e.g. Listrik, Air, Tinta, Kertas, Gaji, Sewa, Transportasi, ATK, Maintenance, Lainnya
  keterangan       String   @default("")
  jumlah           Float // amount in Rupiah
  metodePembayaran String   @default("Tunai") // Tunai, Transfer, Kartu, QRIS, Lainnya
  supplier         String   @default("")
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ===== STOCK BAHAN (bahan baku cetak: kertas, tinta, dll.) =====
model Bahan {
  id          String   @id @default(cuid())
  kode        String // auto: BHN-001, BHN-002, ... per user
  nama        String
  kategori    String   @default("") // e.g. Kertas, Tinta, Kimia, Plastik, Lainnya
  satuan      String   @default("pcs") // pcs, rim, lembar, kg, roll, box, pack, liter, tube
  stok        Float    @default(0)
  stokMin     Float    @default(0) // batas minimum — peringatan stok rendah
  hargaSatuan Float    @default(0) // harga modal per satuan (Rupiah) untuk nilai stok
  keterangan  String   @default("") // catatan bebas + "Ref PO: ..." dari Referensi PO
  aktif       Boolean  @default(true) // status aktif bahan
  lokasi      String   @default("") // lokasi penyimpanan (mis. Gudang A — Rak 2)
  pemasok     String   @default("") // supplier utama bahan ini
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mutasi BahanMutasi[]

  @@unique([userId, kode])
  @@index([userId])
}

model BahanMutasi {
  id          String   @id @default(cuid())
  bahanId     String
  jenis       String // 'masuk' | 'keluar' | 'penyesuaian'
  qty         Float // masuk/keluar: selalu positif; penyesuaian: delta (boleh negatif)
  stokSetelah Float    @default(0) // snapshot stok setelah mutasi ini
  keterangan  String   @default("")
  nomor       String   @default("") // nomor transaksi auto: SM-001 / SK-001 / SP-001
  tanggal     String   @default("") // tanggal transaksi (yyyy-mm-dd) pilihan user
  nomorNota   String   @default("") // nomor nota / faktur pembelian (stok masuk)
  pemasok     String   @default("") // nama supplier (stok masuk)
  hargaBeli   Float    @default(0) // harga beli per satuan (stok masuk)
  totalHarga  Float    @default(0) // qty × hargaBeli (stok masuk)
  satuanBahan String   @default("") // snapshot satuan bahan saat transaksi
  namaBahan   String   @default("") // snapshot nama bahan saat transaksi
  tujuan      String   @default("") // tujuan stok keluar: Produksi/Sampel/Rusak/Pemakaian internal/Lainnya
  alasan      String   @default("") // alasan penyesuaian: Stok opname/Stok rusak/dll.
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bahan Bahan @relation(fields: [bahanId], references: [id], onDelete: Cascade)

  @@index([bahanId])
  @@index([userId])
}

// ==================== PEMBAYARAN MANUAL (Manual Payment System) ====================
// Status pembayaran: UNPAID | WAITING_VERIFICATION | PAID | REJECTED | EXPIRED | CANCELLED
// Status langganan : ACTIVE | EXPIRED | CANCELLED | SUSPENDED
// Aktivasi langganan HANYA setelah admin menyetujui pembayaran (verify approve).

// Paket berlangganan — harga & durasi diatur admin (tidak permanen di kode)
model SubscriptionPlan {
  id              String   @id @default(cuid())
  planName        String
  price           Float
  discountPercent Float    @default(0) // diskon % jika ada
  durationMonths  Int
  maxAccounts     Int      @default(2)
  features        String   @default("[]") // JSON array string daftar fitur
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions  PaymentTransaction[]
  subscriptions UserSubscription[]
}

// Transaksi pembayaran manual (transfer bank / QRIS)
model PaymentTransaction {
  id                 String    @id @default(cuid())
  transactionNumber  String    @unique // TRX-YYYYMMDD-XXXXXX
  userId             String? // Pengguna.id jika login; null untuk checkout tamu
  customerName       String
  customerEmail      String
  customerPhone      String    @default("")
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  planName           String // snapshot nama paket
  durationMonths     Int // snapshot durasi
  amount             Float // snapshot harga paket saat transaksi dibuat
  discountAmount     Float     @default(0)
  totalAmount        Float // amount - discountAmount
  paymentMethod      String    @default("bank_transfer") // bank_transfer | qris_manual
  paymentStatus      String    @default("UNPAID")
  expiresAt          DateTime // batas waktu pembayaran
  metadata           String    @default("{}") // {username, password?} utk aktivasi akun baru
  verifiedBy         String? // Pengguna.id admin
  verifiedByName     String?
  verifiedAt         DateTime?
  activatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  confirmations PaymentConfirmation[]
  subscriptions UserSubscription[]
  auditLogs     PaymentAuditLog[]

  @@index([paymentStatus])
  @@index([userId])
  @@index([customerEmail])
}

// Bukti pembayaran (bisa lebih dari 1 jika diunggah ulang setelah ditolak)
model PaymentConfirmation {
  id                   String   @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  senderName           String
  senderBank           String
  transferAmount       Float
  transferDate         DateTime
  proofFileUrl         String // data URL base64 (dilayani via API ber-otorisasi)
  proofFileName        String   @default("")
  customerNote         String   @default("")
  verificationStatus   String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason      String   @default("")
  verifiedBy           String?
  verifiedByName       String?
  verifiedAt           DateTime?
  createdAt            DateTime @default(now())

  @@index([paymentTransactionId])
}

// Langganan pelanggan — terpisah dari status pembayaran
model UserSubscription {
  id                   String   @id @default(cuid())
  userId               String // Pengguna.id
  subscriptionPlanId   String
  subscriptionPlan     SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  planName             String
  startDate            DateTime
  endDate              DateTime
  subscriptionStatus   String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | SUSPENDED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionStatus])
}

// Pengaturan rekening pembayaran — diisi admin, ditampilkan di checkout
model PaymentSetting {
  id                   String   @id @default(cuid())
  bankName             String   @default("")
  accountName          String   @default("")
  accountNumber        String   @default("")
  qrisProviderName     String   @default("")
  qrisImageUrl         String   @default("") // data URL base64
  paymentInstructions  String   @default("")
  paymentDeadlineHours Int      @default(24)
  bankTransferEnabled  Boolean  @default(true)
  qrisEnabled          Boolean  @default(true)
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Audit log seluruh tindakan admin pada pembayaran manual
model PaymentAuditLog {
  id                   String   @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  action               String // CREATED | PROOF_SUBMITTED | APPROVED | REJECTED | ACTIVATED
  actorId              String   @default("")
  actorName            String   @default("")
  details              String   @default("")
  createdAt            DateTime @default(now())

  @@index([paymentTransactionId])
}

// Notifikasi in-app (bell dashboard) — userId "" = untuk admin
model Notification {
  id        String   @id @default(cuid())
  userId    String   @default("")
  title     String
  message   String   @default("")
  type      String   @default("info") // info | success | warning | error
  link      String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
