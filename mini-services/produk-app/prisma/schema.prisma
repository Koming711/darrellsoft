generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/mini-services/produk-app/db/custom.db"
}

// ============================================================
// Darrellsoft — Manajemen Penjualan & Harga Customer
// Uang disimpan sebagai DECIMAL (bukan floating point).
// Field tanggal "date-only" disimpan pada pukul 12:00 UTC
// agar perbandingan hari aman dari masalah zona waktu.
// ============================================================

model Company {
  id             String                 @id @default(cuid())
  name           String
  users          User[]
  customers      Customer[]
  products       Product[]
  customerPrices CustomerProductPrice[]
  invoices       Invoice[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("STAFF") // OWNER | ADMIN | SALES | STAFF
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String                 @id @default(cuid())
  code           String
  name           String
  phone          String?
  email          String?
  address        String?
  isActive       Boolean                @default(true)
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  prices         CustomerProductPrice[]
  invoices       Invoice[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([companyId, code])
  @@index([companyId, name])
}

model Product {
  id             String                 @id @default(cuid())
  code           String
  name           String
  unit           String                 @default("pcs")
  sellingPrice   Decimal                // harga standar (Master Produk)
  costPrice      Decimal                // harga pokok (tidak pernah diubah oleh harga jual)
  stock          Int                    @default(0)
  isActive       Boolean                @default(true)
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  prices         CustomerProductPrice[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([companyId, code])
  @@index([companyId, name])
}

// Tabel inti fitur: harga barang berbeda per customer
model CustomerProductPrice {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  sellingPrice Decimal  // harga khusus customer
  unit         String
  validFrom    DateTime
  validUntil   DateTime? // null = berlaku selamanya
  isActive     Boolean  @default(true)
  note         String?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, customerId, productId])
  @@index([companyId, isActive])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoiceDate DateTime
  dueDate     DateTime?
  status      String        @default("UNPAID") // UNPAID | PARTIAL | PAID
  subtotal    Decimal // jumlah seluruh subtotal item
  discount    Decimal       @default(0) // diskon nominal
  taxPercent  Decimal       @default(0)
  taxAmount   Decimal       @default(0)
  total       Decimal
  amountPaid  Decimal       @default(0)
  note        String?
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  items       InvoiceItem[]
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId, invoiceDate])
  @@index([companyId, customerId])
}

// Snapshot harga saat transaksi — invoice lama tetap tidak berubah
// meskipun daftar harga master/customer berubah di kemudian hari.
model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  productCode  String // snapshot
  productName  String // snapshot
  unit         String
  quantity     Decimal
  unitPrice    Decimal // harga jual saat transaksi (snapshot)
  costPrice    Decimal // harga pokok saat transaksi (snapshot, untuk margin)
  priceSource  String // CUSTOMER_PRICE | STANDARD | MANUAL
  manualReason String? // alasan perubahan harga manual
  subtotal     Decimal
  createdAt    DateTime @default(now())

  @@index([invoiceId])
  @@index([productId])
}
