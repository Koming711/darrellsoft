DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Midtrans Test Mode ───────────────────────────────────────────
# When MIDTRANS_TEST_MODE=true, the app simulates Midtrans transactions
# without calling the real Midtrans API. This allows full-flow testing
# (payment → account creation → auto-login) without valid credentials.
#
# To use REAL Midtrans sandbox:
#   1. Register at https://account.midtrans.com/register
#   2. Login to MAP (Merchant Administration Portal)
#   3. Go to Settings > Access Keys to get your sandbox Server Key & Client Key
#   4. Set MIDTRANS_TEST_MODE=false and fill in the real keys below
# ──────────────────────────────────────────────────────────────────
# ─── Base URL ──────────────────────────────────────────────────────
# Used for Midtrans redirect URLs and callback endpoints
NEXT_PUBLIC_BASE_URL=https://www.darrellsoft.com

# ─── Midtrans Configuration ────────────────────────────────────────
# Set MIDTRANS_TEST_MODE=false and MIDTRANS_IS_PRODUCTION=true for live payments
MIDTRANS_TEST_MODE=false
NEXT_PUBLIC_MIDTRANS_TEST_MODE=false

# Midtrans Production Keys
# Get your keys from: https://dashboard.midtrans.com/settings/access_keys
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_WITH_YOUR_KEY
MIDTRANS_IS_PRODUCTION=true
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=true
